RewriteEngine On

# Redirect plain HTTP requests to HTTPS while preserving the host and path.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]

# Serve real files and folders directly; route everything else through the SPA.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

<IfModule mod_headers.c>
  <FilesMatch "\.(?:css|js|mjs|png|jpe?g|webp|gif|svg|ico|webm|mp4|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>